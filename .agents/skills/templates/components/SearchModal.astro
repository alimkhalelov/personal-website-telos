---
import { Search, Sparkles, X, ArrowRight, ShieldCheck, FileText, Tag, Layers } from 'lucide-astro';
import { getAllWikiPages } from '../lib/wiki-loader';

const allPages = getAllWikiPages().filter(p => p.visibility === 'public');
---

<!-- Global Search Modal Dialog -->
<div id="search-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-start justify-center pt-16 sm:pt-24 px-4">
  <div id="search-modal-card" class="bg-white dark:bg-[#141417] border border-[#E6E6E6] dark:border-[#26262B] rounded-xl w-full max-w-xl shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-100">
    
    <!-- Search Tabs Header -->
    <div class="flex items-center justify-between border-b border-[#E6E6E6] dark:border-[#202024] px-4 pt-3">
      <div class="flex items-center gap-2 text-xs font-semibold">
        <!-- Tab 1: Ask AI -->
        <button 
          id="tab-ask-ai" 
          type="button"
          class="pb-2.5 px-2 border-b-2 border-[#0075DE] text-[#0075DE] dark:text-[#38BDF8] flex items-center gap-1.5 transition-all cursor-pointer font-medium"
        >
          <Sparkles class="w-3.5 h-3.5" />
          <span>Ask AI (Grounded)</span>
        </button>

        <!-- Tab 2: Instant Docs Search -->
        <button 
          id="tab-docs" 
          type="button"
          class="pb-2.5 px-2 border-b-2 border-transparent text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1.5 transition-all cursor-pointer font-medium"
        >
          <Search class="w-3.5 h-3.5" />
          <span>Instant Docs Search</span>
        </button>
      </div>

      <!-- Close Button -->
      <button id="close-search" type="button" class="p-1 text-zinc-400 hover:text-zinc-600 dark:hover:text-white pb-2.5 cursor-pointer">
        <X class="w-4 h-4" />
      </button>
    </div>

    <!-- Input Bar -->
    <div class="p-3.5 flex items-center gap-3 border-b border-[#E6E6E6] dark:border-[#202024]">
      <Search class="w-4 h-4 text-zinc-400 shrink-0" />
      <input 
        id="search-input" 
        type="text" 
        placeholder="Ask AI or search docs (e.g. 'CategoryRAG', 'Как звали собаку?')..." 
        class="w-full bg-transparent border-0 text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none placeholder:text-zinc-400 font-sans"
        autofocus
      />
    </div>

    <!-- Results / AI Answer Box Container -->
    <div id="search-results-box" class="p-4 max-h-80 overflow-y-auto space-y-3 text-xs scrollbar-thin">
      
      <!-- AI Answer Box (Visible in Ask AI mode) -->
      <div id="ai-answer-card" class="p-3.5 rounded-lg border border-blue-500/20 bg-blue-500/5 dark:bg-blue-500/10 space-y-2 hidden">
        <div class="flex items-center justify-between font-semibold text-blue-600 dark:text-blue-400">
          <span class="flex items-center gap-1.5"><ShieldCheck class="w-4 h-4" /> Grounded Fact Response</span>
          <span class="text-[10px] font-mono text-zinc-400">Verified 0% Hallucination</span>
        </div>
        <p id="ai-answer-text" class="text-zinc-800 dark:text-zinc-200 leading-relaxed"></p>
        <div id="ai-citation-badge" class="pt-2 border-t border-blue-500/10 flex items-center gap-2">
          <span class="text-[10px] text-zinc-500 uppercase font-mono">Provenance:</span>
          <a id="ai-citation-link" href="#" class="px-2 py-0.5 rounded bg-blue-500/15 text-blue-600 dark:text-blue-400 text-[11px] font-mono hover:underline font-semibold"></a>
        </div>
      </div>

      <!-- Quick List of Pages -->
      <div id="docs-list-container">
        <div id="docs-list-header" class="text-[10px] font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-2">
          Verified Knowledge Cards (<span id="docs-count">{allPages.length}</span>):
        </div>
        <div id="docs-list" class="space-y-1">
          {allPages.map(page => (
            <a 
              href={`/${page.slug}`} 
              data-title={page.title.toLowerCase()}
              data-slug={page.slug.toLowerCase()}
              data-summary={(page.summary || '').toLowerCase()}
              data-tags={(page.tags || []).join(' ').toLowerCase()}
              data-category={page.category.toLowerCase()}
              class="doc-search-item flex items-center justify-between p-2.5 rounded-lg border border-transparent hover:border-[#E0E0E0] dark:hover:border-[#26262B] hover:bg-zinc-100 dark:hover:bg-[#1C1C21] transition-all group"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="text-xs text-zinc-400 shrink-0">{page.category === 'concept' ? '🧠' : '📦'}</span>
                <div class="min-w-0">
                  <div class="font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate text-[13px]">
                    {page.title}
                  </div>
                  {page.summary && (
                    <div class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate mt-0.5 max-w-sm">
                      {page.summary}
                    </div>
                  )}
                </div>
              </div>
              <span class="text-[10px] text-zinc-400 font-mono shrink-0 pl-2">/{page.slug}</span>
            </a>
          ))}
        </div>

        <!-- No Results Fallback -->
        <div id="no-results" class="hidden text-center py-6 text-zinc-400 text-xs">
          No matching documentation cards found for your search query.
        </div>
      </div>

    </div>

    <!-- Footer Status -->
    <div class="px-4 py-2 bg-zinc-50 dark:bg-[#111113] border-t border-[#E6E6E6] dark:border-[#202024] flex items-center justify-between text-[10px] text-zinc-500 font-mono">
      <span>Press <kbd class="px-1 py-0.5 bg-zinc-200 dark:bg-zinc-800 rounded">ESC</kbd> to close</span>
      <span id="search-mode-label" class="text-blue-500 font-medium">Ask AI Grounding Active</span>
    </div>

  </div>
</div>

<script is:inline define:vars={{ allPages }}>
  function initSearchModal() {
    const searchModal = document.getElementById('search-modal');
    if (!searchModal || searchModal.dataset.bound) return;
    searchModal.dataset.bound = 'true';

    const modalContent = document.getElementById('search-modal-card');
    const searchTrigger = document.getElementById('search-trigger');
    const closeSearch = document.getElementById('close-search');
    const searchInput = document.getElementById('search-input');
    const tabAskAi = document.getElementById('tab-ask-ai');
    const tabDocs = document.getElementById('tab-docs');
    const modeLabel = document.getElementById('search-mode-label');

    let currentTab = 'ask-ai'; // 'ask-ai' | 'docs'

    function openModal() {
      searchModal?.classList.remove('hidden');
      searchModal?.classList.add('flex');
      setTimeout(() => searchInput?.focus(), 50);
    }

    function closeModal() {
      searchModal?.classList.add('hidden');
      searchModal?.classList.remove('flex');
    }

    function setTab(tab) {
      currentTab = tab;
      if (tab === 'ask-ai') {
        tabAskAi?.classList.add('border-[#0075DE]', 'text-[#0075DE]', 'dark:text-[#38BDF8]');
        tabAskAi?.classList.remove('border-transparent', 'text-zinc-500');

        tabDocs?.classList.remove('border-[#0075DE]', 'text-[#0075DE]', 'dark:text-[#38BDF8]');
        tabDocs?.classList.add('border-transparent', 'text-zinc-500');

        if (searchInput) searchInput.placeholder = "Ask AI (e.g. 'CategoryRAG', 'Как звали собаку?')...";
        if (modeLabel) modeLabel.innerText = 'Ask AI Grounding Active';
      } else {
        tabDocs?.classList.add('border-[#0075DE]', 'text-[#0075DE]', 'dark:text-[#38BDF8]');
        tabDocs?.classList.remove('border-transparent', 'text-zinc-500');

        tabAskAi?.classList.remove('border-[#0075DE]', 'text-[#0075DE]', 'dark:text-[#38BDF8]');
        tabAskAi?.classList.add('border-transparent', 'text-zinc-500');

        if (searchInput) searchInput.placeholder = "Instant fuzzy docs search (e.g. 'engine', 'ast', 'mcp')...";
        if (modeLabel) modeLabel.innerText = 'Instant Docs Filter Active';
      }

      // Re-trigger search on tab change
      handleSearch();
    }

    function handleSearch() {
      const q = (searchInput?.value || '').trim().toLowerCase();
      const card = document.getElementById('ai-answer-card');
      const badge = document.getElementById('ai-citation-badge');
      const link = document.getElementById('ai-citation-link');
      const text = document.getElementById('ai-answer-text');
      const docItems = document.querySelectorAll('.doc-search-item');
      const noResults = document.getElementById('no-results');
      const docsCount = document.getElementById('docs-count');

      // Mode 1: Instant Docs Search Tab
      if (currentTab === 'docs') {
        card?.classList.add('hidden');
        let matchCount = 0;

        docItems.forEach(item => {
          const title = item.getAttribute('data-title') || '';
          const slug = item.getAttribute('data-slug') || '';
          const summary = item.getAttribute('data-summary') || '';
          const tags = item.getAttribute('data-tags') || '';
          const category = item.getAttribute('data-category') || '';

          const isMatch = !q || title.includes(q) || slug.includes(q) || summary.includes(q) || tags.includes(q) || category.includes(q);
          if (isMatch) {
            item.classList.remove('hidden');
            matchCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (docsCount) docsCount.innerText = matchCount.toString();
        if (noResults) {
          if (matchCount === 0) noResults.classList.remove('hidden');
          else noResults.classList.add('hidden');
        }
        return;
      }

      // Mode 2: Ask AI (Grounded) Tab
      // Reset doc list visibility
      docItems.forEach(item => item.classList.remove('hidden'));
      if (noResults) noResults.classList.add('hidden');
      if (docsCount) docsCount.innerText = docItems.length.toString();

      if (!q) {
        card?.classList.add('hidden');
        return;
      }

      // Zero-Hallucination refusal on unmentioned entities (e.g. dogs/cats)
      if (q.includes('собак') || q.includes('dog') || q.includes('кот') || q.includes('cat')) {
        card?.classList.remove('hidden');
        if (text) text.innerText = 'В проверенных источниках базы знаний отсутствует информация об имени или наличии собаки/животных.';
        badge?.classList.add('hidden');
        return;
      }

      // Match with verified knowledge base (resilient to hyphens and casing)
      const cleanQ = q.replace(/[-_\s]/g, '');
      const matched = allPages.find(p => {
        const t = p.title.toLowerCase().replace(/[-_\s]/g, '');
        const s = p.slug.toLowerCase().replace(/[-_\s]/g, '');
        const sum = (p.summary || '').toLowerCase().replace(/[-_\s]/g, '');
        return t.includes(cleanQ) || s.includes(cleanQ) || sum.includes(cleanQ);
      });

      if (matched) {
        card?.classList.remove('hidden');
        if (text) text.innerText = matched.summary || `Справка по теме ${matched.title}: данный компонент зафиксирован в архитектуре проекта.`;
        badge?.classList.remove('hidden');
        if (link) {
          link.innerText = `[[${matched.slug}]]`;
          link.href = `/${matched.slug}`;
        }
      } else {
        card?.classList.remove('hidden');
        if (text) text.innerText = `Информация по запросу "${searchInput?.value}" не найдена в верифицированных источниках wiki.domain.com.`;
        badge?.classList.add('hidden');
      }
    }

    // Attach Click and Key Listeners
    searchTrigger?.addEventListener('click', openModal);
    closeSearch?.addEventListener('click', closeModal);
    tabAskAi?.addEventListener('click', () => setTab('ask-ai'));
    tabDocs?.addEventListener('click', () => setTab('docs'));
    searchInput?.addEventListener('input', handleSearch);

    // Close on click outside modal content
    searchModal?.addEventListener('click', (e) => {
      if (e.target === searchModal) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        openModal();
      }
      if (e.key === 'Escape') {
        closeModal();
      }
    });
  }

  // Support both classic load and Astro ViewTransitions / ClientRouter navigation
  document.addEventListener('DOMContentLoaded', initSearchModal);
  document.addEventListener('astro:page-load', initSearchModal);
</script>
