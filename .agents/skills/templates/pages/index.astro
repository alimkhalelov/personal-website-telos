---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getAllWikiPages } from '../lib/wiki-loader';
import { Sparkles, Layers, Database, ArrowRight, ShieldCheck, Tag, GitBranch, User, ChevronDown } from 'lucide-astro';

const allPages = getAllWikiPages();
const concepts = allPages.filter((p) => p.category === 'concept' && p.visibility === 'public');
const entities = allPages.filter((p) => p.category === 'entity' && p.visibility === 'public');
---

<DocsLayout 
  title="Overview & Catalog" 
  summary="Open-source Git-Native AI Wiki & Graph Documentation Platform" 
  currentSlug="index"
  category="Getting Started"
  allPages={allPages}
>
  <!-- Notion Document Header Area -->
  <div class="space-y-4 pb-6">
    
    <!-- Document Main Title -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-zinc-950 dark:text-[#F4F4F5] tracking-tight leading-[1.15]">
      AI-Native Documentation & Knowledge Graph
    </h1>

    <!-- Notion Database Properties Header with Toggle Button -->
    <div class="pt-1">
      <button
        id="toggle-properties-btn"
        class="inline-flex items-center gap-1.5 text-[12.5px] font-medium text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors py-1 px-2 -ml-2 rounded-md hover:bg-zinc-200/60 dark:hover:bg-zinc-800/60 cursor-pointer"
        title="Toggle Page Properties"
      >
        <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200" id="prop-chevron" />
        <span id="prop-btn-text">Hide properties</span>
      </button>
    </div>

    <!-- Notion Database Property Grid Container -->
    <div id="properties-grid-container" class="transition-all duration-200">
      <div class="grid grid-cols-1 sm:grid-cols-[160px_1fr] gap-y-3 gap-x-6 text-[13.5px] pt-2 pb-2 text-zinc-600 dark:text-zinc-400">
        
        <!-- Version -->
        <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
          <GitBranch class="w-4 h-4" />
          <span>Version</span>
        </div>
        <div class="flex items-center gap-1.5 text-zinc-900 dark:text-zinc-200 font-semibold font-mono text-[12px]">
          <span class="px-2.5 py-0.5 rounded-md bg-zinc-200/80 dark:bg-[#1C1C21] border border-zinc-300/60 dark:border-zinc-700/60">v1.0.0 (Production)</span>
        </div>

        <!-- Domain -->
        <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
          <Layers class="w-4 h-4" />
          <span>Domain</span>
        </div>
        <div class="flex items-center gap-1.5 text-zinc-900 dark:text-zinc-200 font-medium">
          <span>Git-Native AI Knowledge Engine</span>
        </div>

        <!-- Labels -->
        <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
          <Tag class="w-4 h-4" />
          <span>Tags</span>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <a href="/#core-concepts" data-astro-prefetch="hover" class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 font-medium text-[12px] hover:underline">zero-hallucination</a>
          <a href="/graph" data-astro-prefetch="hover" class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-medium text-[12px] hover:underline">ast-graph</a>
          <a href="/graph" data-astro-prefetch="hover" class="px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 font-medium text-[12px] hover:underline">obsidian-parity</a>
        </div>

        <!-- Grounding -->
        <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
          <ShieldCheck class="w-4 h-4 text-emerald-500" />
          <span>Grounding</span>
        </div>
        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm shadow-emerald-500/50"></span>
          <span>Synthius CategoryRAG (Verified 0% Hallucination)</span>
        </div>

        <!-- Contributors -->
        <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
          <User class="w-4 h-4" />
          <span>Contributors</span>
        </div>
        <div class="flex items-center gap-2.5">
          <div class="flex -space-x-1.5">
            <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 border-2 border-[#0C0C0E] flex items-center justify-center text-[11px] text-white font-bold">A</div>
            <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-amber-500 to-rose-500 border-2 border-[#0C0C0E] flex items-center justify-center text-[11px] text-white font-bold">AI</div>
          </div>
          <span class="text-zinc-500 text-[12px]">Autonomous Compiler</span>
        </div>

      </div>
    </div>

  </div>

  <!-- Notion Section Divider -->
  <div class="border-t border-[#E6E6E6] dark:border-[#202024] my-6"></div>

  <!-- Description Section Header -->
  <div class="flex items-center gap-2 text-[12px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-5">
    <span class="text-base">≡</span>
    <span>Description & Architecture</span>
  </div>

  <!-- TL;DR Minimalist Block -->
  <div class="mb-8 space-y-2">
    <div class="text-xl sm:text-2xl font-black text-zinc-950 dark:text-white tracking-tight">
      TL;DR
    </div>
    <p class="text-[16.5px] text-zinc-700 dark:text-zinc-300 leading-relaxed">
      This open-source platform replaces manual documentation writing with an autonomous compiler. Your AI Agent in Cursor/Antigravity writes structured Markdown and commits to Git; the website delivers high-end GitBook-grade reading and interactive 2D/3D knowledge graphs with 0% hallucinations.
    </p>
  </div>

  <!-- Content Sections -->
  <section class="space-y-10 text-[16px] leading-[1.8] text-zinc-700 dark:text-zinc-300">
    
    <div id="core-concepts" class="scroll-mt-24">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 dark:text-[#F4F4F5] tracking-tight mb-2.5">
        Core Concepts & Architecture
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 mb-5">
        The system strictly decouples the <strong>Read-Plane</strong> (static, read-only web documentation) from the <strong>Write-Plane</strong> (AI Agent running locally inside your IDE with atomic Git commits).
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {concepts.map((concept) => (
          <a
            href={`/${concept.slug}`}
            data-astro-prefetch="hover"
            class="group p-4 rounded-xl border border-[#E6E6E6] dark:border-[#26262B] bg-white dark:bg-[#141417] hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 font-semibold">
                  concept
                </span>
                <ArrowRight class="w-4 h-4 text-zinc-400 group-hover:translate-x-1 group-hover:text-blue-500 transition-all" />
              </div>
              <h3 class="font-bold text-zinc-900 dark:text-white text-[17px] mb-1.5 group-hover:text-blue-500 transition-colors">
                {concept.title}
              </h3>
              <p class="text-zinc-500 text-[13.5px] line-clamp-2 leading-snug">
                {concept.summary}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Entities Section -->
    <div id="entities" class="scroll-mt-24 pt-6 border-t border-[#E6E6E6] dark:border-[#202024]">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 dark:text-[#F4F4F5] tracking-tight mb-2.5">
        Entities & Core Engine Components
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 mb-5">
        Ground-truth components verified against <code>wiki/schema.yaml</code> with strict 0% AI hallucination enforcement.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {entities.map((entity) => (
          <a
            href={`/${entity.slug}`}
            data-astro-prefetch="hover"
            class="group p-4 rounded-xl border border-[#E6E6E6] dark:border-[#26262B] bg-white dark:bg-[#141417] hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-semibold">
                  entity
                </span>
                <ArrowRight class="w-4 h-4 text-zinc-400 group-hover:translate-x-1 group-hover:text-emerald-500 transition-all" />
              </div>
              <h3 class="font-bold text-zinc-900 dark:text-white text-[17px] mb-1.5 group-hover:text-emerald-500 transition-colors">
                {entity.title}
              </h3>
              <p class="text-zinc-500 text-[13.5px] line-clamp-2 leading-snug">
                {entity.summary}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>

  </section>
</DocsLayout>
