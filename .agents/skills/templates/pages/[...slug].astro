---
import DocsLayout from '../layouts/DocsLayout.astro';
import { getAllWikiPages, getWikiPageBySlug } from '../lib/wiki-loader';
import type { WikiPage } from '../lib/wiki-loader';
import { marked } from 'marked';
import { preprocessCustomMarkdown } from '../lib/markdown-extensions';
import { 
  Calendar, Hash, ArrowLeft, ArrowRight, Sparkles, ChevronDown, Check, 
  ZoomIn, ZoomOut, RotateCcw, GitBranch, Layers, Tag, ShieldCheck, User 
} from 'lucide-astro';

export async function getStaticPaths() {
  const pages = getAllWikiPages();
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page, allPages: pages },
  }));
}

interface Props {
  page: WikiPage;
  allPages: WikiPage[];
}

const { page, allPages } = Astro.props;

// Configure marked with custom heading and mermaid code renderers
const renderer = {
  heading({ text, depth }: { text: string; depth: number }) {
    const slug = text
      .toLowerCase()
      .replace(/[^\w\u0400-\u04FF]+/g, '-')
      .replace(/^-+|-+$/g, '');
    return `<h${depth} id="${slug}" class="scroll-mt-24">${text}</h${depth}>`;
  },
  code({ text, lang }: { text: string; lang?: string }) {
    if (lang === 'mermaid') {
      return `<div class="mermaid-block relative group my-8 p-4 rounded-2xl border border-[#E6E6E6] dark:border-[#26262B] bg-[#FAFAFA] dark:bg-[#121215] overflow-hidden shadow-sm">
        <div class="mermaid-controls absolute top-3 right-3 z-10 flex items-center gap-1 bg-white/95 dark:bg-[#1C1C21]/95 backdrop-blur border border-[#E0E0E0] dark:border-[#2B2B33] rounded-lg p-1 opacity-80 group-hover:opacity-100 transition-opacity shadow-md">
          <button type="button" class="mermaid-btn-in p-1.5 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-600 dark:text-zinc-300 transition-colors cursor-pointer" title="Zoom In">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </button>
          <button type="button" class="mermaid-btn-out p-1.5 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-600 dark:text-zinc-300 transition-colors cursor-pointer" title="Zoom Out">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </button>
          <button type="button" class="mermaid-btn-reset px-2 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 text-blue-500 transition-colors text-[11px] font-mono font-semibold cursor-pointer" title="Reset Zoom">Fit</button>
        </div>
        <div class="mermaid-viewport w-full overflow-hidden flex justify-center py-4 cursor-grab active:cursor-grabbing select-none">
          <div class="mermaid-canvas transform-gpu origin-center transition-transform duration-150 flex justify-center w-full">
            <pre class="mermaid text-center bg-transparent p-0 m-0 border-0">${text}</pre>
          </div>
        </div>
      </div>`;
    }
    return false; // use default code renderer with global copy injector
  }
};

marked.use({ gfm: true, breaks: false, renderer });

// Strip out the first H1 in markdown content if it duplicates page title
let cleanContent = page.content.replace(/^#\s+.+$/m, '').trim();

// Transform [[Wikilinks]] (even if wrapped in backticks `[[Wikilinks]]`) into clean Notion-style pill links
cleanContent = cleanContent.replace(/`?\[\[(?:wiki\/)?([^\]#|`]+)(?:#([^\]|`]+))?(?:\|([^\]`]+))?\]\]`?/g, (match, target, anchor, label) => {
  const cleanTarget = target.trim();
  const displayLabel = label ? label.trim() : cleanTarget.split('/').pop() || cleanTarget;
  const href = `/${cleanTarget}${anchor ? `#${anchor}` : ''}`;
  return `<a href="${href}" data-astro-prefetch="hover" class="inline-flex items-center gap-1 text-[#0075DE] dark:text-[#38BDF8] hover:underline font-mono text-[14px] bg-blue-500/10 px-2 py-0.5 rounded-md border border-blue-500/20">[[${displayLabel}]]</a>`;
});

// Preprocess custom :::tabs and :::details syntax before parsing
cleanContent = preprocessCustomMarkdown(cleanContent);

// Parse Markdown to rich semantic HTML
const renderedHtml = marked.parse(cleanContent);
---

<DocsLayout
  title={page.title}
  summary={page.summary}
  category={page.category}
  lastUpdated={page.last_updated}
  currentSlug={page.slug}
  tags={page.tags}
  headings={page.headings}
  allPages={allPages}
>
  <!-- Document Title & Header Area -->
  <header class="mb-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold uppercase tracking-wider bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
        {page.category}
      </span>
      {page.tags && page.tags.map((tag) => (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-medium bg-[#EFEFED] dark:bg-[#18181C] text-zinc-600 dark:text-zinc-400 border border-[#E0E0E0] dark:border-[#26262B]">
          <Hash class="w-3 h-3 text-zinc-400" />
          <span>{tag}</span>
        </span>
      ))}
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-[#191919] dark:text-[#F4F4F5] tracking-tight leading-[1.2]">
      {page.title}
    </h1>

    {page.summary && (
      <p class="text-lg text-zinc-600 dark:text-zinc-300 mt-3 leading-relaxed">
        {page.summary}
      </p>
    )}

    <!-- Collapsible Notion Property Grid Toggle -->
    <div class="mt-5 border-t border-[#E6E6E6] dark:border-[#202024] pt-3">
      <div class="flex items-center justify-between mb-2">
        <button
          id="toggle-properties-btn"
          type="button"
          class="inline-flex items-center gap-1.5 text-[12.5px] font-medium text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors py-1 px-2 -ml-2 rounded-md hover:bg-zinc-200/60 dark:hover:bg-zinc-800/60 cursor-pointer"
          title="Toggle Page Properties"
        >
          <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200" id="prop-chevron" />
          <span id="prop-btn-text">Hide properties</span>
        </button>
        <div class="text-[11px] font-mono text-zinc-400">
          Last edited {page.last_updated}
        </div>
      </div>

      <!-- Notion Database Properties List (Exact 2-column layout matching screenshot) -->
      <div id="properties-grid-container" class="transition-all duration-200">
        <div class="grid grid-cols-1 sm:grid-cols-[160px_1fr] gap-y-3 gap-x-6 text-[13.5px] pt-2 pb-2 text-zinc-600 dark:text-zinc-400">
          
          <!-- Version -->
          <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
            <GitBranch class="w-4 h-4" />
            <span>Version</span>
          </div>
          <div class="flex items-center gap-1.5 text-zinc-900 dark:text-zinc-200 font-semibold font-mono text-[12px]">
            <span class="px-2.5 py-0.5 rounded-md bg-zinc-200/80 dark:bg-[#1C1C21] border border-zinc-300/60 dark:border-zinc-700/60">v1.2.0-AST</span>
          </div>

          <!-- Domain -->
          <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
            <Layers class="w-4 h-4" />
            <span>Domain</span>
          </div>
          <div class="flex items-center gap-1.5 text-zinc-900 dark:text-zinc-200 font-medium capitalize">
            <span>{page.category}</span>
          </div>

          <!-- Tags -->
          <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
            <Tag class="w-4 h-4" />
            <span>Tags</span>
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            {page.tags && page.tags.map((tag, idx) => {
              const colors = [
                'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20',
                'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
                'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
              ];
              const colorCls = colors[idx % colors.length];
              return (
                <span class={`px-2.5 py-0.5 rounded-full border font-medium text-[12px] ${colorCls}`}>
                  {tag}
                </span>
              );
            })}
          </div>

          <!-- Grounding -->
          <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
            <ShieldCheck class="w-4 h-4 text-emerald-500" />
            <span>Grounding</span>
          </div>
          <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shadow-sm shadow-emerald-500/50"></span>
            <span>Synthius CategoryRAG (Verified 0% Hallucination)</span>
          </div>

          <!-- Contributors -->
          <div class="flex items-center gap-2.5 text-zinc-500 font-medium">
            <User class="w-4 h-4" />
            <span>Contributors</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="flex -space-x-1.5">
              <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 border-2 border-[#0C0C0E] flex items-center justify-center text-[11px] text-white font-bold">A</div>
              <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-amber-500 to-rose-500 border-2 border-[#0C0C0E] flex items-center justify-center text-[11px] text-white font-bold">AI</div>
            </div>
            <span class="text-zinc-500 text-[12px]">Autonomous Compiler</span>
          </div>

        </div>
      </div>
    </div>
  </header>

  <!-- Semantic HTML Rendered Markdown Article -->
  <article class="prose prose-zinc dark:prose-invert max-w-none text-[16.5px]">
    <div set:html={renderedHtml} />
  </article>

  <!-- Backlinks Section (Obsidian Parity: Inbound References) -->
  {page.backlinks && page.backlinks.length > 0 && (
    <div class="mt-14 pt-8 border-t border-[#E6E6E6] dark:border-[#202024]">
      <h3 class="text-sm font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider mb-4 flex items-center gap-2">
        <Sparkles class="w-4 h-4 text-amber-500" />
        <span>Mentioned In ({page.backlinks.length} Backlinks)</span>
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {page.backlinks.map((linkSlug) => {
          const linkedPage = allPages.find((p) => p.slug === linkSlug);
          return (
            <a
              href={`/${linkSlug}`}
              data-astro-prefetch="hover"
              class="p-3.5 rounded-xl border border-[#E6E6E6] dark:border-[#26262B] bg-white dark:bg-[#141417] hover:border-[#0075DE] dark:hover:border-blue-500 hover:shadow-md transition-all group block"
            >
              <div class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-[#0075DE] dark:group-hover:text-[#38BDF8] flex items-center justify-between">
                <span>{linkedPage?.title || linkSlug}</span>
                <span class="text-xs font-mono text-zinc-400 uppercase">{linkedPage?.category || 'Note'}</span>
              </div>
              {linkedPage?.summary && (
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 line-clamp-2 leading-relaxed">
                  {linkedPage.summary}
                </p>
              )}
            </a>
          );
        })}
      </div>
    </div>
  )}

  <!-- Ultra-Fast Interactive Tabs, Dynamic Mermaid & Pan/Zoom Script -->
  <script>
    async function initArticleFeatures() {
      // 1. Synchronously bind interactive Tab switchers (0ms latency)
      document.querySelectorAll('.tab-container').forEach((container) => {
        const buttons = container.querySelectorAll<HTMLButtonElement>('.tab-btn');
        const panes = container.querySelectorAll<HTMLElement>('.tab-pane');

        buttons.forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = 'true';
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-target');

            buttons.forEach((b) => {
              b.classList.remove('border-[#0075DE]', 'text-[#0075DE]', 'dark:text-[#38BDF8]', 'font-semibold');
              b.classList.add('border-transparent', 'text-zinc-500');
            });

            btn.classList.add('border-[#0075DE]', 'text-[#0075DE]', 'dark:text-[#38BDF8]', 'font-semibold');
            btn.classList.remove('border-transparent', 'text-zinc-500');

            panes.forEach((pane) => {
              if (pane.id === targetId) {
                pane.classList.remove('hidden');
              } else {
                pane.classList.add('hidden');
              }
            });
          });
        });
      });

      // 2. Dynamic Mermaid Renderer with Light/Dark Theme Parity
      const mermaidNodes = document.querySelectorAll<HTMLElement>('.mermaid');
      if (mermaidNodes.length > 0) {
        const { default: mermaid } = await import('mermaid');
        const isDark = document.documentElement.classList.contains('dark');
        
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'neutral',
          themeVariables: {
            fontFamily: 'Plus Jakarta Sans, Google Sans Flex, sans-serif',
            primaryColor: isDark ? '#1E293B' : '#F0F7FF',
            primaryTextColor: isDark ? '#F8FAFC' : '#0F172A',
            primaryBorderColor: isDark ? '#38BDF8' : '#0075DE',
            lineColor: isDark ? '#94A3B8' : '#64748B',
            mainBkg: isDark ? '#18181C' : '#FFFFFF',
            nodeBorder: isDark ? '#38BDF8' : '#0075DE',
            clusterBkg: isDark ? '#141417' : '#F1F5F9',
          },
        });

        await mermaid.run({ nodes: Array.from(mermaidNodes) });

        // 3. Attach Pan & Zoom controls to each Mermaid block
        document.querySelectorAll('.mermaid-block').forEach((block) => {
          if (block.getAttribute('data-zoom-bound')) return;
          block.setAttribute('data-zoom-bound', 'true');

          const canvas = block.querySelector<HTMLElement>('.mermaid-canvas');
          const viewport = block.querySelector<HTMLElement>('.mermaid-viewport');
          const btnIn = block.querySelector<HTMLButtonElement>('.mermaid-btn-in');
          const btnOut = block.querySelector<HTMLButtonElement>('.mermaid-btn-out');
          const btnReset = block.querySelector<HTMLButtonElement>('.mermaid-btn-reset');

          if (!canvas || !viewport) return;

          let scale = 1;
          let posX = 0;
          let posY = 0;
          let isDragging = false;
          let startX = 0;
          let startY = 0;

          function updateTransform() {
            if (!canvas) return;
            canvas.style.transform = `translate(${posX}px, ${posY}px) scale(${scale})`;
          }

          btnIn?.addEventListener('click', () => {
            scale = Math.min(scale * 1.3, 4);
            updateTransform();
          });

          btnOut?.addEventListener('click', () => {
            scale = Math.max(scale / 1.3, 0.4);
            updateTransform();
          });

          btnReset?.addEventListener('click', () => {
            scale = 1;
            posX = 0;
            posY = 0;
            updateTransform();
          });

          // Mouse Drag Pan
          viewport.addEventListener('mousedown', (e) => {
            if ((e.target as HTMLElement).closest('.mermaid-controls')) return;
            isDragging = true;
            startX = e.clientX - posX;
            startY = e.clientY - posY;
            viewport.style.cursor = 'grabbing';
          });

          window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            posX = e.clientX - startX;
            posY = e.clientY - startY;
            updateTransform();
          });

          window.addEventListener('mouseup', () => {
            if (isDragging) {
              isDragging = false;
              viewport.style.cursor = 'grab';
            }
          });

          // Wheel Zoom over diagram
          viewport.addEventListener('wheel', (e) => {
            e.preventDefault();
            const delta = e.deltaY > 0 ? 0.9 : 1.1;
            scale = Math.max(0.4, Math.min(4, scale * delta));
            updateTransform();
          }, { passive: false });
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initArticleFeatures);
    document.addEventListener('astro:page-load', initArticleFeatures);
  </script>
</DocsLayout>
